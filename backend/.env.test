# Used only by `npm run test:e2e` - a separate database so integration
# tests never touch real dev data. Created via:
#   docker exec playops-postgres-1 psql -U postgres -c "CREATE DATABASE playops_test;"
#   DATABASE_URL=<this one> npx prisma migrate deploy

PORT=4000
NODE_ENV=test

DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/playops_test"
# Keeps each e2e spec file's own Nest app (and the test helper client
# below) from accumulating too many pooled connections across a serial
# --runInBand run - see prisma.service.ts's comment.
DATABASE_POOL_MAX=3

JWT_SECRET=test-only-secret-not-for-production-use-0123456789abcdef
JWT_EXPIRES_IN=12h

COLLEGE_EMAIL_DOMAIN=@thapar.edu
ALLOWED_ORIGIN=http://localhost:3000
