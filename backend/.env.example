# Copy to .env and fill in real values. Never commit the real .env file.

PORT=4000
NODE_ENV=development

# PostgreSQL connection - fill in once Postgres is actually running
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/playops"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

JWT_EXPIRES_IN=12h

# Only emails ending in this domain can sign up - the entire eligibility gate at registration
COLLEGE_EMAIL_DOMAIN=@yourcollege.edu

# The frontend's origin, for CORS
ALLOWED_ORIGIN=http://localhost:3000
